# witness: the three modes in order, each held long enough to measure, then a release and the voice freed.
# The point is not that it sounds good; it is that each mode's kernel is the only thing in the path.
tempo 120
steps 16
tail 1.0
track lead
#      P1  P2  A   D   S   R  fx1 fx2 flt res pan lvl porta lfo-d lfo-s tgt shp style
preset  0 128  0  70 200  20  0   0  255  0  128 200  0   128  100 255  0   0
note 0  C3 2 100        # sine, clean
param p1 40 4
note 4  C3 2 100        # sine, driven
param p1 128 8
note 8  C3 2 100        # saw, clipped
param p1 240 12
param p2 200 12
param filter 96 12
param resonance 160 12
note 12 C3 2 100        # noise through a resonant band-pass
expect sound   0 1.8
expect sound   4 5.8
expect sound   8 9.8
expect sound   12 13.8
expect idle    18         # the envelope finished, the host freed every voice
expect peak_below -11.5   # under the -12 dBFS per-voice target in every mode
